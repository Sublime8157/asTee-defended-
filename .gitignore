/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# Database dumps — contain customer PII (names, addresses, contact numbers,
# email addresses, bcrypt password hashes). Never commit these.
*.sql
!database/**/*.sql
# Container bootstrap SQL is tracked, except the production dump copied in by
# hand as 01-schema.sql (see docker/README.md).
!docker/mysql-init/*.sql
docker/mysql-init/01-schema.sql

# Local tooling / build artefacts that don't belong in version control
composer.phar
*.zip
