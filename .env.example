APP_NAME=AsTee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production must set: APP_ENV=production, APP_DEBUG=false, APP_URL=https://...
# APP_DEBUG=true in production leaks stack traces, file contents and env vars
# on every 500 via Ignition.

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asTeeFinal
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Must be true in production — without it the session cookie is sent over
# plain HTTP and is trivially stealable on a shared network.
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Internal addresses that receive operational mail (new order, new feedback,
# admin account requests). Previously hardcoded in controllers.
MAIL_ORDERS_ADDRESS=orders@example.com
MAIL_FEEDBACK_ADDRESS=feedback@example.com
MAIL_ACCOUNTS_ADDRESS=accounts@example.com

# PayMongo — https://dashboard.paymongo.com/developers
# Use the pk_test_/sk_test_ pair for development. The webhook secret is shown
# once when you create the webhook; the app rejects unsigned callbacks.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Shipping fee applied at checkout, in PHP. Server-side only — never accept
# this from the client.
SHIPPING_FEE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
